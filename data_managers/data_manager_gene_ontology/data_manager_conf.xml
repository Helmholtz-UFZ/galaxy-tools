<data_managers>
    <data_manager tool_file="data_manager/gene_ontology_datamanager.xml" id="gene_ontology_download">
        <data_table name="gene_ontology">
            <output>
                <column name="value"/>
                <column name="name"/>
                <column name="version"/>
                <column name="path" output_ref="out_file">
                    <move type="directory">
                        <source>${path}</source>
                        <target base="${GALAXY_DATA_MANAGER_DATA_PATH}">gene_ontology/${version}</target>
                    </move>
                    <value_translation>${GALAXY_DATA_MANAGER_DATA_PATH}/gene_ontology/${version}/go-basic.obo</value_translation>
                    <value_translation type="function">abspath</value_translation>
                </column>
            </output>
        </data_table>
    </data_manager>
</data_managers>
