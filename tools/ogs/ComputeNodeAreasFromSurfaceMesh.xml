<tool name="OGS: ComputeNodeAreasFromSurfaceMesh" id="ogs_computenodeareasfromsurfacemesh" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
  <description>The tool computes the area per node of the surface mesh and writes the information as txt and csv data.</description>
  <macros>
    <import>macros.xml</import>
    <import>test_macros.xml</import>
  </macros>
  <expand macro="requirements" />
  <expand macro="creator" />
  <version_command><![CDATA[ComputeNodeAreasFromSurfaceMesh --version]]></version_command>
  <command><![CDATA[
ln -sf '$mesh_input_file' 'mesh_input_file.vtu';
ComputeNodeAreasFromSurfaceMesh
    --mesh-input-file 'mesh_input_file.vtu'
#if str($id_prop_name)
    --id-prop-name '$id_prop_name'
#end if
    --output-base-name node_areas
]]></command>
  <inputs>
    <param argument="--mesh-input-file" type="data" optional="false" label="mesh input file" help="Input (.vtu). The name of the file containing the input mesh" format="vtkxml" />
    <param argument="--id-prop-name" type="select" optional="true" label="id prop name" help="the name of the property containing the id information" multiple="false">
      <option value="bulk_node_ids">bulk_node_ids</option>
      <option value="bulk_element_ids">bulk_element_ids</option>
      <option value="bulk_edge_ids">bulk_edge_ids</option>
      <option value="bulk_face_ids">bulk_face_ids</option>
    </param>
  </inputs>
  <outputs>
    <data name="node_areas_csv" format="csv" label="Node areas (CSV)" from_work_dir="node_areas.csv" hidden="false" />
    <data name="node_areas_txt" format="txt" label="Node areas (plain text)" from_work_dir="node_areas.txt" hidden="false" />
  </outputs>
  <tests>
    <expand macro="computenodeareasfromsurfacemesh_test" />
  </tests>
  <help>The tool computes the area per node of the surface mesh and writes the information as txt and csv data.</help>
  <expand macro="citations" />
</tool>
