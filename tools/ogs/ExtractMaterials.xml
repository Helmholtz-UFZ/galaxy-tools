<tool name="OGS: ExtractMaterials" id="ogs_extractmaterials" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
  <description>Takes a mesh with multiple MaterialIDs and writes elements of a given ID into a new mesh.</description>
  <macros>
    <import>macros.xml</import>
    <import>test_macros.xml</import>
  </macros>
  <expand macro="requirements" />
  <expand macro="creator" />
  <version_command><![CDATA[ExtractMaterials --version]]></version_command>
  <command><![CDATA[
ln -sf '$input' 'input.vtu';
ExtractMaterials
#if str($material_id)
    --material-id '$material_id'
#end if
    --input 'input.vtu'
    --output output.vtu
]]></command>
  <inputs>
    <param argument="--material-id" type="integer" optional="true" label="material id" help="The MaterialID for which elements should be extracted into a new mesh." />
    <param argument="--input" type="data" optional="false" label="input" help="Input (.vtu). Name of the input mesh" format="vtkxml" />
  </inputs>
  <outputs>
    <collection name="tool_outputs" type="list" label="Outputs from ExtractMaterials">
      <discover_datasets pattern="(?!(?:input\.vtu)$)(?P&lt;designation&gt;output_.*)\.vtu" format="vtkxml" visible="true" />
    </collection>
    <data name="layer_info" format="txt" label="Layer/material table" from_work_dir="output_Layers.txt" hidden="false" />
  </outputs>
  <tests>
    <expand macro="extractmaterials_test" />
  </tests>
  <help>Takes a mesh with multiple MaterialIDs and writes elements of a given ID into a new mesh. If no ID is specified, meshes for each existing MaterialID are created.</help>
  <expand macro="citations" />
</tool>
