<?xml version="1.0" encoding="UTF-8"?>
<tool name="OGS: MoveGeometry" id="ogs_movegeometry" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
  <description>Galaxy wrapper for the OGS utility 'MoveGeometry'.</description>
  <macros>
    <import>macros.xml</import>
    <import>test_macros.xml</import>
  </macros>
  <expand macro="requirements" />
  <expand macro="creator" />
  <version_command><![CDATA[MoveGeometry --version]]></version_command>
  <command><![CDATA[
ln -sf '$input' '$input.element_identifier';
MoveGeometry
#if str($z)
    --z '$z'
#end if
#if str($y)
    --y '$y'
#end if
#if str($x)
    --x '$x'
#end if
    --input '$input.element_identifier'
    --output output_1.gml
]]></command>
  <inputs>
    <param argument="--z" type="float" optional="true" label="z" help="displacement in z direction" />
    <param argument="--y" type="float" optional="true" label="y" help="displacement in y direction" />
    <param argument="--x" type="float" optional="true" label="x" help="displacement in x direction" />
    <param argument="--input" type="data" optional="false" label="input" help="Input (.gml) geometry file" format="xml" />
  </inputs>
  <outputs>
    <data name="output_movegeometry" format="xml" label="Output from MoveGeometry" from_work_dir="output_1.gml" hidden="false" />
  </outputs>
  <tests>
    <expand macro="movegeometry_test" />
  </tests>
  <help>This tool runs the **MoveGeometry** utility from the OpenGeoSys suite.</help>
  <expand macro="citations" />
</tool>