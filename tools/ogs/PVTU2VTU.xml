<?xml version="1.0" encoding="UTF-8"?>
<tool name="OGS: PVTU2VTU" id="ogs_pvtu2vtu" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
  <description>Galaxy wrapper for the OGS utility 'PVTU2VTU'.</description>
  <macros>
    <import>macros.xml</import>
    <import>test_macros.xml</import>
  </macros>
  <expand macro="requirements" />
  <expand macro="creator" />
  <version_command><![CDATA[pvtu2vtu --version]]></version_command>
  <command><![CDATA[
ln -sf '$input' '$input.element_identifier';
pvtu2vtu
    --input '$input.element_identifier'
#if str($original_mesh)
    --original_mesh '$original_mesh'
#end if
    $compress
    --output output_1.vtu
]]></command>
  <inputs>
    <param argument="--input" type="data" optional="false" label="input" help="Input (.pvtu). The partitioned input mesh file" format="vtkxml" />
    <param argument="--original_mesh" type="text" optional="true" label="original mesh" help="optional, the original unpartitioned input mesh (*.vtu)" />
    <param argument="--compress" type="boolean" label="compress" help="Compress the output (vtu file)." checked="false" truevalue="--compress" falsevalue="" />
  </inputs>
  <outputs>
    <data name="output_pvtu2vtu" format="vtkxml" label="Output from PVTU2VTU" from_work_dir="output_1.vtu" hidden="false" />
  </outputs>
  <tests>
    <expand macro="pvtu2vtu_test" />
  </tests>
  <help>This tool runs the **PVTU2VTU** utility from the OpenGeoSys suite.</help>
  <expand macro="citations" />
</tool>