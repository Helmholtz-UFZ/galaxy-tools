<tool name="OGS: Raster2ASC" id="ogs_raster2asc" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
  <description>Converts ascii raster files (e.g. Surfer *.grd files or *.xyz files) into ASC raster files.</description>
  <macros>
    <import>macros.xml</import>
    <import>test_macros.xml</import>
  </macros>
  <expand macro="requirements" />
  <expand macro="creator" />
  <version_command><![CDATA[Raster2ASC --version]]></version_command>
  <command><![CDATA[
ln -sf '$input' 'input.grd';
Raster2ASC
    --input 'input.grd'
    --output output_1.asc
]]></command>
  <inputs>
    <param argument="--input" type="data" optional="false" label="input" help="Input (.grd | .xyz). Filename for input raster" format="raster.asc" />
  </inputs>
  <outputs>
    <data name="output_raster2asc" format="raster.asc" label="Output from Raster2ASC" from_work_dir="output_1.asc" hidden="false" />
  </outputs>
  <tests>
    <expand macro="raster2asc_test" />
  </tests>
  <help>Converts ascii raster files (e.g. Surfer \*.grd files or \*.xyz files) into ASC raster files.</help>
  <expand macro="citations" />
</tool>
