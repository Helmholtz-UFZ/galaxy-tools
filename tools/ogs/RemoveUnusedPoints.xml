<?xml version="1.0" encoding="UTF-8"?>
<tool name="OGS: RemoveUnusedPoints" id="ogs_removeunusedpoints" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
  <description>Galaxy wrapper for the OGS utility 'RemoveUnusedPoints'.</description>
  <macros>
    <import>macros.xml</import>
    <import>test_macros.xml</import>
  </macros>
  <expand macro="requirements" />
  <expand macro="creator" />
  <version_command><![CDATA[RemoveUnusedPoints --version]]></version_command>
  <command><![CDATA[
ln -sf '$input' '${input}.gml';
RemoveUnusedPoints
    --input '${input}.gml'
    --output output_1.gml
]]></command>
  <inputs>
    <param argument="--input" type="data" optional="false" label="input" help="Input (.gml) geometry" format="xml" />
  </inputs>
  <outputs>
    <data name="output_removeunusedpoints" format="xml" label="Output from RemoveUnusedPoints" from_work_dir="output_1.gml" hidden="false" />
  </outputs>
  <tests>
    <expand macro="removeunusedpoints_test" />
  </tests>
  <help>This tool runs the **RemoveUnusedPoints** utility from the OpenGeoSys suite.</help>
  <expand macro="citations" />
</tool>