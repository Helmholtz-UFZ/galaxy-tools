<?xml version="1.0" encoding="UTF-8"?>
<tool name="OGS: appendLinesAlongPolyline" id="ogs_appendlinesalongpolyline" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
  <description>Galaxy wrapper for the OGS utility 'appendLinesAlongPolyline'.</description>
  <macros>
    <import>macros.xml</import>
    <import>test_macros.xml</import>
  </macros>
  <expand macro="requirements" />
  <expand macro="creator" />
  <version_command><![CDATA[appendLinesAlongPolyline --version]]></version_command>
  <command><![CDATA[
ln -sf '$mesh_input_file' '${mesh_input_file}.vtu';
ln -sf '$geo_file' '${geo_file}.gml';
ln -sf '$gmsh_path' '${gmsh_path}.msh';
appendLinesAlongPolyline
    --mesh-input-file '${mesh_input_file}.vtu'
    --geo-file '${geo_file}.gml'
    --gmsh-path '${gmsh_path}.msh'
    --mesh-output-file output_1.vtu
]]></command>
  <inputs>
    <param argument="--mesh-input-file" type="data" optional="false" label="mesh input file" help="Input (.vtu). The name of the file containing the input mesh" format="vtkxml" />
    <param argument="--geo-file" type="data" optional="false" label="geo file" help="Input (.gml). The name of the input geometry file which contains polylines" format="xml" />
    <param argument="--gmsh-path" type="data" optional="true" label="gmsh path" help="Input (.msh). The path to the input gmsh binary file" format="gmsh.msh" />
  </inputs>
  <outputs>
    <data name="output_appendlinesalongpolyline" format="vtkxml" label="Output from appendLinesAlongPolyline" from_work_dir="output_1.vtu" hidden="false" />
  </outputs>
  <tests>
    <expand macro="appendlinesalongpolyline_test" />
  </tests>
  <help>This tool runs the **appendLinesAlongPolyline** utility from the OpenGeoSys suite.</help>
  <expand macro="citations" />
</tool>