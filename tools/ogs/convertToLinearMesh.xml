<?xml version="1.0" encoding="UTF-8"?>
<tool name="OGS: convertToLinearMesh" id="ogs_converttolinearmesh" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
  <description>Galaxy wrapper for the OGS utility 'convertToLinearMesh'.</description>
  <macros>
    <import>macros.xml</import>
    <import>test_macros.xml</import>
  </macros>
  <expand macro="requirements" />
  <expand macro="creator" />
  <version_command><![CDATA[convertToLinearMesh --version]]></version_command>
  <command><![CDATA[
ln -sf '$input_mesh_file' '$input_mesh_file.vtu';
convertToLinearMesh
    --input-mesh-file '$input_mesh_file.vtu'
    --output-mesh-file output_1.vtu
]]></command>
  <inputs>
    <param argument="--input-mesh-file" type="data" optional="false" label="input mesh file" help="Input (.vtu | .msh) mesh file" format="vtkxml" />
  </inputs>
  <outputs>
    <data name="output_converttolinearmesh" format="vtkxml" label="Output from convertToLinearMesh" from_work_dir="output_1.vtu" hidden="false" />
  </outputs>
  <tests>
    <expand macro="converttolinearmesh_test" />
  </tests>
  <help>This tool runs the **convertToLinearMesh** utility from the OpenGeoSys suite.</help>
  <expand macro="citations" />
</tool>