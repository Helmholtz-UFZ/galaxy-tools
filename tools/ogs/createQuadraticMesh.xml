<tool name="OGS: createQuadraticMesh" id="ogs_createquadraticmesh" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
  <description>Create quadratic order mesh.</description>
  <macros>
    <import>macros.xml</import>
    <import>test_macros.xml</import>
  </macros>
  <expand macro="requirements" />
  <expand macro="creator" />
  <version_command><![CDATA[createQuadraticMesh --version]]></version_command>
  <command><![CDATA[
ln -sf '$input_mesh_file' 'input_mesh_file.vtu';
createQuadraticMesh
    --input-mesh-file 'input_mesh_file.vtu'
    $add_centre_node
    --output-mesh-file output_1.vtu
]]></command>
  <inputs>
    <param argument="--input-mesh-file" type="data" optional="false" label="input mesh file" help="Input (.vtu | .msh) mesh file" format="vtkxml" />
    <param argument="--add-centre-node" type="boolean" label="add centre node" help="add centre node" checked="false" truevalue="--add-centre-node" falsevalue="" />
  </inputs>
  <outputs>
    <data name="output_createquadraticmesh" format="vtkxml" label="Output from createQuadraticMesh" from_work_dir="output_1.vtu" hidden="false" />
  </outputs>
  <tests>
    <expand macro="createquadraticmesh_test" />
  </tests>
  <help>Create quadratic order mesh.</help>
  <expand macro="citations" />
</tool>
