<macros>
    <token name="@TOOL_VERSION@">6.5.9</token>
    <token name="@PROFILE@">23.0</token>
    <token name="@VERSION_SUFFIX@">0</token>

    <!-- OGS package requirement. Hand-written tools expand this inside their own
         <requirements> block; generated tools expand the full `requirements` block below. -->
    <xml name="ogs_requirement">
        <requirement type="package" version="@TOOL_VERSION@">ogs</requirement>
        <yield/>
    </xml>

    <!-- Full <requirements> block (used by the auto-generated OGS utility tools). -->
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">ogs</requirement>
        </requirements>
    </xml>

    <!-- OGS citation. Kept as the stable house DOI; `citations` below is the alias
         used by the auto-generated tools. -->
    <xml name="ogs_citation">
        <citations>
            <citation type="doi">10.1007/s12665-012-1546-x</citation>
        </citations>
    </xml>

    <xml name="citations">
        <citations>
            <citation type="doi">10.1007/s12665-012-1546-x</citation>
        </citations>
    </xml>

    <xml name="creator">
        <creator>
            <person givenName="Matthias" familyName="Bernt" identifier="https://orcid.org/0000-0003-3763-0797" url="https://github.com/bernt-matthias"/>
            <organization name="Helmholtz Centre for Environmental Research - UFZ" url="https://www.ufz.de/"/>
        </creator>
    </xml>
</macros>
