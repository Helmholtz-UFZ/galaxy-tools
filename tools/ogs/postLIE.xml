<tool name="OGS: postLIE" id="ogs_postlie" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
  <description>Post-process results of the LIE approach.</description>
  <macros>
    <import>macros.xml</import>
    <import>test_macros.xml</import>
  </macros>
  <expand macro="requirements" />
  <expand macro="creator" />
  <version_command><![CDATA[postLIE --version]]></version_command>
  <command><![CDATA[
ln -sf '$input_file' 'input_file.vtu';
postLIE
    --input-file 'input_file.vtu'
    $no_overwrite
    --output-file output_1.vtu
]]></command>
  <inputs>
    <param argument="--input-file" type="data" optional="false" label="input file" help="Input (.vtu | .pvd). The original PVD or VTU file name" format="vtkxml" />
    <param argument="--no-overwrite" type="boolean" label="no overwrite" help="don't overwrite existing post processed VTU files" checked="false" truevalue="--no-overwrite" falsevalue="" />
  </inputs>
  <outputs>
    <data name="output_postlie" format="vtkxml" label="Output from postLIE" from_work_dir="output_1.vtu" hidden="false" />
  </outputs>
  <tests>
    <expand macro="postlie_test" />
  </tests>
  <help>Post-process results of the LIE approach.</help>
  <expand macro="citations" />
</tool>
