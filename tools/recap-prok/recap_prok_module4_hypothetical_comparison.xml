<tool id="recap_prok_module4_hypothetical_comparison" name="RECAP-PROK Hypothetical Protein Comparison" version="0.1.0" profile="25.1">
    <description>compare hypothetical proteins and prepare NR query FASTA files</description>
    <requirements>
        <requirement type="package" version="3.12">python</requirement>
        <requirement type="package" version="1.84">biopython</requirement>
        <requirement type="package" version="3.9.2">matplotlib</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/module4_hypothetical_comparison.py'
  --reann-gb '$reann_gb'
  --ref-gb '$ref_gb'
  --out-table '$comparison'
  --out-reann-faa '$reann_hypothetical'
  --out-ref-faa '$ref_hypothetical'
  --out-pdf '$figure'
    ]]></command>
    <inputs>
        <param name="reann_gb" type="data" format="genbank" label="Re-annotated GenBank"/>
        <param name="ref_gb" type="data" format="genbank" label="Reference-mapped GenBank"/>
    </inputs>
    <outputs>
        <data name="comparison" format="tabular" label="${tool.name} on ${on_string}: comparison table"/>
        <data name="reann_hypothetical" format="fasta" label="${tool.name} on ${on_string}: re-annotated hypothetical proteins"/>
        <data name="ref_hypothetical" format="fasta" label="${tool.name} on ${on_string}: reference-mapped hypothetical proteins"/>
        <data name="figure" format="pdf" label="${tool.name} on ${on_string}: hypothetical protein figure"/>
    </outputs>
    <tests>
        <test>
            <param name="reann_gb" value="Re-annotated_08.gb"/>
            <param name="ref_gb" value="Ref_NCBI_mapped_08.gb"/>
            <output name="comparison">
                <assert_contents>
                    <has_text text="Protein_coding_CDSs"/>
                    <has_text text="Re-annotated&#x9;2&#x9;1&#x9;50.00&#x9;1"/>
                    <has_text text="Reference-mapped&#x9;3&#x9;1&#x9;33.33&#x9;2"/>
                </assert_contents>
            </output>
            <output name="reann_hypothetical">
                <assert_contents>
                    <has_text text="&gt;Re-annotated|REANN_TEST|locus=REANN_001|protein=REANN_P001"/>
                </assert_contents>
            </output>
            <output name="ref_hypothetical">
                <assert_contents>
                    <has_text text="&gt;Reference-mapped|REF_TEST|locus=REF_001|protein=REF_P001"/>
                </assert_contents>
            </output>
            <output name="figure">
                <assert_contents>
                    <has_size value="10000" delta="10000"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
Compares hypothetical-protein content between the re-annotated and reference-mapped
GenBank files. The two FASTA outputs are intended as query inputs to Galaxy DIAMOND
against NCBI NR.
    ]]></help>
